#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Private/BlueNoise.ush"

#include "RCHashTable.ush"
#include "/Engine/Private/RayTracing/RayTracingCommon.ush"
#include "RCCommon.ush"

// Shader parameters
RWTexture2D<float4> Output;

StructuredBuffer<uint4> ProbeRadiance;
StructuredBuffer<uint> ProbeWeights;
StructuredBuffer<uint> ProbeDepositCount;


Texture2D<float4> FinalIrradiance;
StructuredBuffer<uint> ProbeToFinalId;
uint FinalAtlasExtend;

uint DisplayCascade;

uint BaseDirections;
uint DebugOutputCells;
float Intensity;

SCREEN_PASS_TEXTURE_VIEWPORT(SceneColorViewport)


uint Hash64(uint Lo, uint Hi)
{
	uint h = MurmurFinalize32(Lo);
	h ^= MurmurFinalize32(Hi) + 0x9E3779B9u + (h << 6) + (h >> 2);
	return MurmurFinalize32(h);
}

float3 HSVtoRGB(float3 c)
{
	float3 p = abs(frac(c.xxx + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
	return c.z * lerp(1.0.xxx, saturate(p - 1.0), c.y);
}

float3 ColorFromHash(uint Lo, uint Hi)
{
	uint h = Hash64(Lo, Hi);
	float Hue = (h & 0xFFFFu) / 65535.0;
	float Sat = 0.55 + 0.35 * ((h >> 16) & 0xFFu) / 255.0;
	float Val = 0.70 + 0.30 * ((h >> 24) & 0xFFu) / 255.0;
	return HSVtoRGB(float3(Hue, Sat, Val));
}

float3 ColorFromHash1(uint h1)
{
	uint h = h1;
	float Hue = (h & 0xFFFFu) / 65535.0;
	float Sat = 0.55 + 0.35 * ((h >> 16) & 0xFFu) / 255.0;
	float Val = 0.70 + 0.30 * ((h >> 24) & 0xFFu) / 255.0;
	return HSVtoRGB(float3(Hue, Sat, Val));
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]
void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	uint2 PixelId = DispatchThreadId;

	// Check that we are in scope
	if (any(float2(DispatchThreadId) >= SceneColorViewport_ViewportSize))
	{
		return;
	}

	float2 ViewportUV = (float2(PixelId) + 0.5f) * SceneColorViewport_ViewportSizeInverse;
	float2 BufferUV = (float2(PixelId) + 0.5f + SceneColorViewport_ViewportMin) * SceneColorViewport_ExtentInverse;

	float DeviceZ = LookupDeviceZ(BufferUV);
	if (DeviceZ == 0)
	{
		return;
	}
	float3 TranslatedWorldPos = SvPositionToTranslatedWorld(
		float4(float2(PixelId) + 0.5f + SceneColorViewport_ViewportMin, DeviceZ, 1.0f));

	float3 WorldPos = DFFastSubtractDemote(TranslatedWorldPos, PrimaryView.PreViewTranslation);
	float3 CameraPos = DFHackToFloat(PrimaryView.WorldCameraOrigin);

	FGBufferData GBufferData = GetGBufferData(BufferUV);
	float3 Normal = GBufferData.WorldNormal;

	uint2 LevelRange;
	float2 LodWeights;
	ComputeLevelRange(WorldPos, CameraPos, LevelRange, LodWeights);

	float4 RadSum = 0;

	for (uint Level = 0; Level < 2; Level++)
	{
		if (Level == 1 && LodWeights.y == 0)
		{
			break;
		}
		float LodVoxel = LevelVoxelSize(LevelRange[Level]) * float(1u << DisplayCascade);
		float3 FloatCell = WorldPos / LodVoxel - 0.5;
		int3 Cell = int3(floor(FloatCell));
		float3 Frac = FloatCell - float3(Cell);

		for (uint c = 0; c < 8; ++c)
		{
			int3 Corner = (Cell) + int3(c & 1, (c >> 1) & 1, c >> 2);
			float3 T = lerp(1.0 - Frac, Frac, float3(c & 1, (c >> 1) & 1, c >> 2));
			float InterpWeight = T.x * T.y * T.z;

			uint64_t CascadeKey = PackProbeKey(Corner, LevelRange[Level]);
			uint Index = HashTableFind(CascadeKey, DisplayCascade);
			if (Index < HashTableSize)
			{
				uint DepositCount = ProbeDepositCount[((DisplayCascade) * HashTableSize) + Index];
				if (DepositCount <= 0)
				{
					continue;
				}

				float DepositWeight = UnpackFloatUnsigned(DepositCount);

				uint Tile = ProbeToFinalId[Index];
				float2 Oct = UnitVectorToOctahedron(Normal) * 0.5 + 0.5;
				float2 Pixel = float2(Tile % FinalAtlasExtend, Tile / FinalAtlasExtend) * 8.0 + 1.0 + Oct * 6.0;
				float2 AtlasSizePixels = (float2)FinalAtlasExtend * 8.0;
				float4 TotalRadiance = FinalIrradiance.SampleLevel(GlobalBilinearClampedSampler,
				                                                   Pixel / AtlasSizePixels, 0);

				float TotalWeight = InterpWeight * LodWeights[Level] * DepositWeight;
				RadSum += TotalRadiance * TotalWeight;
			}
		}
	}

	Output[PixelId] += float4((RadSum.xyz / RadSum.w) *
	                          Intensity * PI * GBufferData.BaseColor, 1);


	//Debug output to see cells
	if (DebugOutputCells == 1)
	{
		uint64_t DebugKey = MakeProbeKey(WorldPos, CameraPos);
		ProbeKeyInfo data = UnpackProbeKey(DebugKey);
		DebugKey = PackProbeKey(data.Cell >> DisplayCascade, data.Level);
		uint DebugIndex = HashTableFind(DebugKey, DisplayCascade);
		Output[PixelId] = float4(ColorFromHash1(MurmurFinalize32(DebugIndex)), 1.0);
	}
}
