//Modified from Engine/Private/HashTable.ush

//The chandra(paper's) implementation uses a smarter hashing thing which is especially nice when doing multibounce since it stays stable, but this is fine for now

#pragma once

#include "/Engine/Public/Platform.ush"

// Linear probing hash table

StructuredBuffer<uint64_t> HashTable;
RWStructuredBuffer<uint64_t> RWHashTable;
uint HashTableSize;

// Returns true if key is added for the first time.
// Index input is the first hash table bucket to look in.
// Index output is the hash table bucket this key is stored in.
bool HashTableAdd(uint64_t Key, inout uint Index, uint Cascade)
{
	// Zero is reserved as invalid
    Key++;

	// TODO v_mul_hi_u32 to avoid integer division
	// ( Index * HashTableSize ) >> 32

	uint TableBase = Cascade * HashTableSize;
	uint CascadeTableSize = HashTableSize >> (2 * Cascade);

    Index = Index % CascadeTableSize;

	LOOP
	ALLOW_UAV_CONDITION

    for (uint i = 0; i < CascadeTableSize; i++)
    {
        uint64_t StoredKey = RWHashTable[TableBase+Index];
        if (StoredKey != Key)
        {
            if (StoredKey != 0)
            {
                Index++;
                Index = Index >= CascadeTableSize ? 0 : Index;
                continue;
            }

            uint64_t PrevKey;
            InterlockedCompareExchange(RWHashTable[TableBase+Index], 0, Key, PrevKey);
			
            if (PrevKey == 0)
                return true;
            else if (PrevKey != Key)
            {
                Index++;
                Index = Index >= CascadeTableSize ? 0 : Index;
                continue;
            }
        }

        break;
    }

    return false;
}

// Returns true if key is found.
// Index input is the first hash table bucket to look in.
// Index output is the hash table bucket this key is stored in if found.
bool HashTableFind(uint64_t Key, inout uint Index, uint Cascade)
{
	// Zero is reserved as invalid
	Key++;


	uint TableBase = Cascade * HashTableSize;
	uint CascadeTableSize = HashTableSize >> (2 * Cascade);
    Index = Index % CascadeTableSize;


	LOOP
	ALLOW_UAV_CONDITION
    for (uint i = 0; i < CascadeTableSize; i++)
	{
		uint64_t StoredKey = HashTable[TableBase + Index];
		if (StoredKey != Key)
		{
			if (StoredKey != 0)
			{
				Index++;
                Index = Index >= CascadeTableSize ? 0 : Index;
				continue;
			}

			return false;
		}

		break;
	}

	return true;
}


//Layout of the key,
#define KEY_BITS_X      19
#define KEY_BITS_Y      19
#define KEY_BITS_Z      19
#define KEY_BITS_LEVEL   4
#define KEY_BITS_VALID   1

#define KEY_SHIFT_X      0
#define KEY_SHIFT_Y     (KEY_SHIFT_X     + KEY_BITS_X)
#define KEY_SHIFT_Z     (KEY_SHIFT_Y     + KEY_BITS_Y)
#define KEY_SHIFT_LEVEL (KEY_SHIFT_Z     + KEY_BITS_Z)
#define KEY_SHIFT_VALID (KEY_SHIFT_LEVEL  + KEY_BITS_LEVEL)
#define KEY_BITS_TOTAL  (KEY_SHIFT_VALID + KEY_BITS_VALID)

//Half extend offset to keep cells positive
#define SIGN_OFFSET (1 << (KEY_BITS_X -1))

#if KEY_BITS_TOTAL > 64
    #error "Probe key layout exceeds 64 bits"
#endif



//Limits from above sizes
static const uint kMaxLevel = (1u << KEY_BITS_LEVEL) - 1u;

static const float kBaseVoxelSize = 32.0;
static const float kLevelBaseDist = 150.0;

uint64_t KeyPack(uint Value, uint Shift, uint Bits)
{
    return (uint64_t) (Value & ((1u << Bits) - 1u)) << Shift;
}

uint KeyUnpack(uint64_t Key, uint Shift, uint Bits)
{
    uint64_t Mask = (1u << Bits)-1u;
    return (uint) ((Key >> Shift) & Mask);
}

uint ComputeLevel(float3 WorldPos, float3 CameraPos)
{
    float3 Distance = abs(WorldPos - CameraPos);
    float Radius = max(Distance.x, max(Distance.y, Distance.z));
    float L = log2(max(Radius / kLevelBaseDist, 1.0)); // base 2
    return (uint) clamp(floor(L), 0.0, (float) kMaxLevel);
}

float LevelVoxelSize(uint Level)
{
    return kBaseVoxelSize * (float) (1u << Level);
}

uint NormalToFace(float3 N)
{
    float3 A = abs(N);
    uint Axis = (A.x >= A.y) ? ((A.x >= A.z) ? 0u : 2u)
                             : ((A.y >= A.z) ? 1u : 2u);
    float S = (Axis == 0u) ? N.x : ((Axis == 1u) ? N.y : N.z);
    return Axis * 2u + (S < 0.0 ? 1u : 0u);
}

uint64_t PackProbeKey(int3 Cell, uint Level)
{
    uint3 UintCell = uint3(Cell) + SIGN_OFFSET;

    return KeyPack(UintCell.x, KEY_SHIFT_X, KEY_BITS_X)
         | KeyPack(UintCell.y, KEY_SHIFT_Y, KEY_BITS_Y)
         | KeyPack(UintCell.z, KEY_SHIFT_Z, KEY_BITS_Z)
         | KeyPack(Level, KEY_SHIFT_LEVEL, KEY_BITS_LEVEL)
         | KeyPack(1u, KEY_SHIFT_VALID, KEY_BITS_VALID);
}

struct ProbeKeyInfo
{
    int3 Cell;
    uint Level;
    bool Valid;
};
ProbeKeyInfo UnpackProbeKey(uint64_t Key)
{
    ProbeKeyInfo Info;

    Info.Cell.x = int(KeyUnpack(Key, KEY_SHIFT_X, KEY_BITS_X)) - SIGN_OFFSET;
    Info.Cell.y = int(KeyUnpack(Key, KEY_SHIFT_Y, KEY_BITS_Y)) - SIGN_OFFSET;
    Info.Cell.z = int(KeyUnpack(Key, KEY_SHIFT_Z, KEY_BITS_Z)) - SIGN_OFFSET;

    Info.Level = KeyUnpack(Key, KEY_SHIFT_LEVEL, KEY_BITS_LEVEL);
    Info.Valid = KeyUnpack(Key, KEY_SHIFT_VALID, KEY_BITS_VALID) != 0u;

    return Info;
}

uint64_t MakeProbeKey(float3 WorldPos, float3 CameraPos)
{
    uint Level = ComputeLevel(WorldPos, CameraPos);
    float VoxelSize = LevelVoxelSize(Level);
    int3 Cell = int3(floor((WorldPos / VoxelSize)));

    return PackProbeKey(Cell, Level);
}


uint MurmurFinalize32(uint h)
{
    h ^= h >> 16;
    h *= 0x85ebca6bu;
    h ^= h >> 13;
    h *= 0xc2b2ae35u;
    h ^= h >> 16;
    return h;
}