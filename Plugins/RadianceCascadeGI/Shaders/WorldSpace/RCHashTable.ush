//Modified/based from Engine/Private/HashTable.ush

//The chandra(paper's) implementation uses a smarter hashing thing which is especially nice when doing multibounce since it stays stable, but this is fine for now

#pragma once

#include "/Engine/Public/Platform.ush"

RWStructuredBuffer<uint64_t> TableKeys;
RWStructuredBuffer<uint> TableFreeList;
RWStructuredBuffer<uint> TableFreeListIndex;

RWStructuredBuffer<uint64_t> TableEntryKeys;
RWStructuredBuffer<uint> TableEntryIndex;
uint HashTableSize;


//Hash function
uint MurmurFinalize32(uint h)
{
    h ^= h >> 16;
    h *= 0x85ebca6bu;
    h ^= h >> 13;
    h *= 0xc2b2ae35u;
    h ^= h >> 16;
    return h;
}


static const uint64_t kInvalidKey = 0;

// Returns true if key is added for the first time.
bool HashTableAdd(uint64_t Key, uint Cascade, out uint OutIndex)
{

	//Get offset of this cascade's hashtable
    uint TableBase = Cascade * HashTableSize;
    uint CascadeTableSize = HashTableSize >> (2 * Cascade);
    uint Index = (MurmurFinalize32(uint(Key) ^ MurmurFinalize32(uint(Key >> 32)))) % CascadeTableSize;
	
    LOOP
	ALLOW_UAV_CONDITION

    for (uint i = 0; i < CascadeTableSize; i++)
    {
		//Get the key, and fill in invalid if gotten.
        uint64_t EntryKey;
        InterlockedCompareExchange(TableEntryKeys[TableBase + Index], kInvalidKey, Key, EntryKey);
	    if (EntryKey == Key)
        {
			//Already inserted
            OutIndex = 0;
            return false;
        }else if (EntryKey == kInvalidKey)
        {
            uint FreeListIndex;
            InterlockedAdd(TableFreeListIndex[Cascade], 1, FreeListIndex);
            uint DataIndex = TableFreeList[FreeListIndex];
        	TableEntryIndex[TableBase + Index] = DataIndex;
            TableKeys[DataIndex] = Key;
            OutIndex = DataIndex;
            return true;
        }
        
		//Probe further, (could also use a different ratio for this)
        Index = (Index + 1) % CascadeTableSize;
    }

    //Table full
    OutIndex = 0;
    return false;
}

// Returns true if key is added for the first time.
bool HashTableAddIndex(uint64_t Key, uint Cascade, uint Index)
{

	//Get offset of this cascade's hashtable
    uint TableBase = Cascade * HashTableSize;
    uint CascadeTableSize = HashTableSize >> (2 * Cascade);
    uint KeyIndex = (MurmurFinalize32(uint(Key) ^ MurmurFinalize32(uint(Key >> 32)))) % CascadeTableSize;
	
    LOOP
	ALLOW_UAV_CONDITION

    for (uint i = 0; i < CascadeTableSize; i++)
    {
		//Get the key, and fill in invalid if gotten.
        uint64_t EntryKey;
        InterlockedCompareExchange(TableEntryKeys[TableBase + KeyIndex], kInvalidKey, Key, EntryKey);
        if (EntryKey == Key)
        {
			//Already inserted
            return false;
        }
        else if (EntryKey == kInvalidKey)
        {
            TableEntryIndex[TableBase + KeyIndex] = Index;
            return true;
        }
        
		//Probe further, (could also use a different ratio for this)
        KeyIndex = (KeyIndex + 1) % CascadeTableSize;
    }

    //Table full
    return false;
}

uint HashTableFind(uint64_t Key, uint Cascade)
{
	//Get offset of this cascade's hashtable
    uint TableBase = Cascade * HashTableSize;
    uint CascadeTableSize = HashTableSize >> (2 * Cascade);
    uint Index = (MurmurFinalize32(uint(Key) ^ MurmurFinalize32(uint(Key >> 32)))) % CascadeTableSize;

    LOOP
	ALLOW_UAV_CONDITION

    for (uint i = 0; i < CascadeTableSize; i++)
    {
		//Get the key, and fill in invalid if gotten.
        uint64_t EntryKey = TableEntryKeys[TableBase + Index];
        if (EntryKey == Key)
        {
            return TableEntryIndex[TableBase + Index];
        }
        else if (EntryKey == kInvalidKey)
        {
            return HashTableSize;
        }
        
		//Probe further, (could also use a different ratio for this)
        Index = (Index + 1) % CascadeTableSize;
    }

    return HashTableSize;
}

//Layout of the key,
static const uint kKeyBitsX = 19;
static const uint kKeyBitsY = 19;
static const uint kKeyBitsZ = 19;
static const uint kKeyBitsLevel = 4;
static const uint kKeyBitsValid = 1;

static const uint kKeyShiftX = 0;
static const uint kKeyShiftY = (kKeyShiftX + kKeyBitsX);
static const uint kKeyShiftZ = (kKeyShiftY + kKeyBitsY);
static const uint kKeyShiftLevel = (kKeyShiftZ + kKeyBitsZ);
static const uint kKeyShiftValid = (kKeyShiftLevel + kKeyBitsLevel);
static const uint kKeyBitsTotal = (kKeyShiftValid + kKeyBitsValid);

//Half extend offset to keep cells positive
static const uint SIGN_OFFSET = (1u << (kKeyBitsX - 1));

#if kKeyBitsTotal > 64
#error "Probe key layout exceeds 64 bits"
#endif


//Limits from above sizes
static const uint kMaxLevel = (1u << kKeyBitsLevel) - 1u;

float BaseVoxelSize = 8.0;
float LevelBaseDist = 250.0;


uint64_t KeyPack(uint Value, uint Shift, uint Bits)
{
	return (uint64_t)(Value & ((1u << Bits) - 1u)) << Shift;
}

uint KeyUnpack(uint64_t Key, uint Shift, uint Bits)
{
	uint64_t Mask = (1u << Bits) - 1u;
	return (uint)((Key >> Shift) & Mask);
}

void ComputeLevelRange(float3 WorldPos, float3 CameraPos, out uint2 Lods, out float2 LodWeights)
{
	float3 Distance = abs(WorldPos - CameraPos);
	float Radius = max(Distance.x, max(Distance.y, Distance.z));
	float LodFloat = max(log2(Radius / LevelBaseDist), -0.9);
	float Blend = min(1.0, (1.0 - frac(LodFloat)));
	uint Lower = clamp((uint)ceil(LodFloat), 0, kMaxLevel);
	Lods = uint2(Lower, Lower + 1);
	LodWeights = float2(Blend, 1.0 - Blend);
}

uint ComputeLevel(float3 WorldPos, float3 CameraPos)
{
	float3 Distance = abs(WorldPos - CameraPos);
	float Radius = max(Distance.x, max(Distance.y, Distance.z));
	float LodFloat = max(log2(Radius / LevelBaseDist), -0.9);
	uint Lower = clamp((uint)ceil(LodFloat), 0, kMaxLevel);
	return Lower;
}

float LevelVoxelSize(uint Level)
{
	return BaseVoxelSize * (float)(1u << Level);
}

uint NormalToFace(float3 N)
{
	float3 A = abs(N);
	uint Axis = (A.x >= A.y)
		            ? ((A.x >= A.z) ? 0u : 2u)
		            : ((A.y >= A.z) ? 1u : 2u);
	float S = (Axis == 0u) ? N.x : ((Axis == 1u) ? N.y : N.z);
	return Axis * 2u + (S < 0.0 ? 1u : 0u);
}

uint64_t PackProbeKey(int3 Cell, uint Level)
{
	uint3 UintCell = uint3(Cell) + SIGN_OFFSET;

	return KeyPack(UintCell.x, kKeyShiftX, kKeyBitsX)
		| KeyPack(UintCell.y, kKeyShiftY, kKeyBitsY)
		| KeyPack(UintCell.z, kKeyShiftZ, kKeyBitsZ)
		| KeyPack(Level, kKeyShiftLevel, kKeyBitsLevel)
		| KeyPack(1u, kKeyShiftValid, kKeyBitsValid);
}

struct ProbeKeyInfo
{
	int3 Cell;
	uint Level;
	bool Valid;
};

ProbeKeyInfo UnpackProbeKey(uint64_t Key)
{
	ProbeKeyInfo Info;

	Info.Cell.x = int(KeyUnpack(Key, kKeyShiftX, kKeyBitsX)) - SIGN_OFFSET;
	Info.Cell.y = int(KeyUnpack(Key, kKeyShiftY, kKeyBitsY)) - SIGN_OFFSET;
	Info.Cell.z = int(KeyUnpack(Key, kKeyShiftZ, kKeyBitsZ)) - SIGN_OFFSET;

	Info.Level = KeyUnpack(Key, kKeyShiftLevel, kKeyBitsLevel);
	Info.Valid = KeyUnpack(Key, kKeyShiftValid, kKeyBitsValid) != 0u;

	return Info;
}

uint64_t MakeProbeKey(float3 WorldPos, float3 CameraPos)
{
	uint Level = ComputeLevel(WorldPos, CameraPos);
	float VoxelSize = LevelVoxelSize(Level);
	int3 Cell = int3(floor((WorldPos / VoxelSize)));

	return PackProbeKey(Cell, Level);
}
