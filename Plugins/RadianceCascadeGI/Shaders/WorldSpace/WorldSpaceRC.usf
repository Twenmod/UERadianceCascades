// Shader parameters
RWTexture2D<float4> Output;

StructuredBuffer<uint64_t> Probes;
RWStructuredBuffer<uint64_t> RWProbes;

SCREEN_PASS_TEXTURE_VIEWPORT(SceneColorViewport)

//Layout of the key,
#define KEY_BITS_X      17
#define KEY_BITS_Y      17
#define KEY_BITS_Z      17
#define KEY_BITS_LEVEL   4
#define KEY_BITS_VALID   1

#define KEY_SHIFT_X      0
#define KEY_SHIFT_Y     (KEY_SHIFT_X     + KEY_BITS_X)
#define KEY_SHIFT_Z     (KEY_SHIFT_Y     + KEY_BITS_Y)
#define KEY_SHIFT_LEVEL (KEY_SHIFT_Z     + KEY_BITS_Z)
#define KEY_SHIFT_VALID (KEY_SHIFT_LEVEL  + KEY_BITS_LEVEL)
#define KEY_BITS_TOTAL  (KEY_SHIFT_VALID + KEY_BITS_VALID)

#if KEY_BITS_TOTAL > 64
    #error "Probe key layout exceeds 64 bits"
#endif

//Limits from above sizes
static const uint kMaxLevel = (1u << KEY_BITS_LEVEL) - 1u;

static const float kBaseVoxelSize = 32.0;
static const float kLevelBaseDist = 200.0;

uint64_t KeyPack(uint Value, uint Shift, uint Bits)
{
    return (uint64_t) (Value & ((1u << Bits) - 1u)) << Shift;
}

uint ComputeLevel(float3 WorldPos, float3 CameraPos)
{
    float3 Distance = abs(WorldPos - CameraPos);
    float Radius = max(Distance.x, max(Distance.y, Distance.z));
    float L = log2(max(Radius / kLevelBaseDist, 1.0)); // base 2
    return (uint) clamp(floor(L), 0.0, (float) kMaxLevel);
}

float LevelVoxelSize(uint Level)
{
    return kBaseVoxelSize * (float) (1u << Level);
}

uint NormalToFace(float3 N)
{
    float3 A = abs(N);
    uint Axis = (A.x >= A.y) ? ((A.x >= A.z) ? 0u : 2u)
                             : ((A.y >= A.z) ? 1u : 2u);
    float S = (Axis == 0u) ? N.x : ((Axis == 1u) ? N.y : N.z);
    return Axis * 2u + (S < 0.0 ? 1u : 0u);
}

uint64_t MakeProbeKey(float3 WorldPos, float3 CameraPos)
{
    uint Level = ComputeLevel(WorldPos, CameraPos);
    float VS = LevelVoxelSize(Level);

    //move along normal with voxel size
    int3 Cell = int3(floor((WorldPos / VS)-0.5));

    return KeyPack((uint) Cell.x, KEY_SHIFT_X, KEY_BITS_X)
         | KeyPack((uint) Cell.y, KEY_SHIFT_Y, KEY_BITS_Y)
         | KeyPack((uint) Cell.z, KEY_SHIFT_Z, KEY_BITS_Z)
         | KeyPack(Level, KEY_SHIFT_LEVEL, KEY_BITS_LEVEL)
         | KeyPack(1u, KEY_SHIFT_VALID, KEY_BITS_VALID);
}

//Hash to color debug
uint MurmurFinalize32(uint h)
{
    h ^= h >> 16;
    h *= 0x85ebca6bu;
    h ^= h >> 13;
    h *= 0xc2b2ae35u;
    h ^= h >> 16;
    return h;
}

uint Hash64(uint Lo, uint Hi)
{
    uint h = MurmurFinalize32(Lo);
    h ^= MurmurFinalize32(Hi) + 0x9E3779B9u + (h << 6) + (h >> 2);
    return MurmurFinalize32(h);
}

float3 HSVtoRGB(float3 c)
{
    float3 p = abs(frac(c.xxx + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return c.z * lerp(1.0.xxx, saturate(p - 1.0), c.y);
}

float3 ColorFromHash(uint Lo, uint Hi)
{
    uint h = Hash64(Lo, Hi);
    float Hue = (h & 0xFFFFu) / 65535.0;
    float Sat = 0.55 + 0.35 * ((h >> 16) & 0xFFu) / 255.0;
    float Val = 0.70 + 0.30 * ((h >> 24) & 0xFFu) / 255.0;
    return HSVtoRGB(float3(Hue, Sat, Val));
}
float3 ColorFromHash1(uint h1)
{
    uint h = h1;
    float Hue = (h & 0xFFFFu) / 65535.0;
    float Sat = 0.55 + 0.35 * ((h >> 16) & 0xFFu) / 255.0;
    float Val = 0.70 + 0.30 * ((h >> 24) & 0xFFu) / 255.0;
    return HSVtoRGB(float3(Hue, Sat, Val));
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)]void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	
    uint2 PixelId = DispatchThreadId;
	
	// Check that we are in scope
    if (any(float2(DispatchThreadId) >= SceneColorViewport_ViewportSize))
        return;

    float2 ViewportUV = (float2(PixelId) + 0.5f) * SceneColorViewport_ViewportSizeInverse;
    float2 BufferUV = (float2(PixelId) + 0.5f + SceneColorViewport_ViewportMin) * SceneColorViewport_ExtentInverse;

    float DeviceZ = LookupDeviceZ(BufferUV);
    if (DeviceZ == 0)
        return;
    float2 ScreenPos = ViewportUVToScreenPos(ViewportUV);
    float3 TranslatedWorldPos = SvPositionToTranslatedWorld(float4(float2(PixelId) + 0.5f + SceneColorViewport_ViewportMin, DeviceZ, 1.0f));

    float3 WorldPos = DFFastSubtractDemote(TranslatedWorldPos, PrimaryView.PreViewTranslation);
    float3 CameraPos = DFHackToFloat(PrimaryView.WorldCameraOrigin);
    
	uint64_t Key = MakeProbeKey(WorldPos, CameraPos);
    uint Index = 0;
    bool hasKey = HashTableFind(Key, Index);
	if (!hasKey)
	{
	    HashTableAdd(Key, Index);
        hasKey = true;
    }
    uint Lo = (uint32_t) (Key & 0xFFFFFFFFull);
    uint Hi = (uint32_t) (Key >> 32);
    float3 Color = ColorFromHash(Lo, Hi);

    //Debug visualisation of the HT
//	Output[PixelId] = float4(hasKey && Index < HashTableSize ? Color : float3(0,0,0), 1);

}