// Custom CS PostProcessing Shader

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/DeferredShadingCommon.ush"
#include "/Engine/Private/SSRT/SSRTRayCast.ush"
#include "/Engine/Private/ScreenPass.ush"
#include "/Engine/Public/Platform.ush"

// Shader parameters

// SceneColor texture
Texture2D OriginalSceneColor;
Texture2D SceneDepth;

Texture2D<float4> PreviousProbeCascade;
RWTexture2D<float4> ProbeCascade;

Texture2D HZB;
float4 HZBUvFactorAndInv;

SCREEN_PASS_TEXTURE_VIEWPORT(SceneColorViewport)
SCREEN_PASS_TEXTURE_VIEWPORT(TraceViewport)
uint Cascade;
uint CascadeCount;
uint BaseRayCount;

float3 UnprojectPixel(float2 Pixel, float LinearDepth)
{
	float2 UV = (Pixel - SceneColorViewport_ViewportMin) * SceneColorViewport_ViewportSizeInverse;
	float2 NDC = ViewportUVToScreenPos(UV);
	return float3(NDC * LinearDepth / float2(View.ViewToClip[0][0], View.ViewToClip[1][1]), LinearDepth);
}

float SliceAngle(float3 Delta, float3 T, float3 ViewDir)
{
	return atan2(dot(Delta, T), dot(Delta, ViewDir));
}

uint BitsForSpan(float ThetaA, float ThetaB)
{
	float A = min(ThetaA, ThetaB);
	float B = max(ThetaA, ThetaB);
	float FA = saturate(A / PI);
	float FB = saturate(B / PI);

	uint Start = min(31u, (uint)floor(FA * 32.0));
	uint Count = (uint)ceil((FB - FA) * 32.0);
	if (Count == 0)
		return 0;
	Count = min(Count, 32u - Start);
	uint Mask = (Count >= 32u) ? 0xFFFFFFFFu : ((1u << Count) - 1u);
	return Mask << Start;
}

[numthreads(THREADS_X, THREADS_Y, THREADS_Z)] void MainCS(uint2 DispatchThreadId : SV_DispatchThreadID)
{
	uint2 PixelId = DispatchThreadId + SceneColorViewport_ViewportMin;
	// Check that we are in scope
	if (any(PixelId >= SceneColorViewport_ViewportMax))
	{
		return;
	}

	int RayCount = pow(BaseRayCount, 1 + Cascade);
	float SqrtBase = sqrt(float(BaseRayCount));
	float Spacing = pow(SqrtBase, Cascade);
	float2 Size = floor(SceneColorViewport_ViewportSize / Spacing);

	// Current probe
	float2 ProbeRelativePosition = DispatchThreadId % Size;
	float2 RayPos = min(floor(DispatchThreadId / Size), Spacing - 1.0);
	// Base index of the rays for knowing which angle to start
	float BaseIndex = float(BaseRayCount) * (RayPos.x + (Spacing * RayPos.y));

	float2 ProbeCenter = (ProbeRelativePosition + 0.5) * Spacing + SceneColorViewport_ViewportMin;

	static const float BaseIntervalPixels = 2.0;

	float Scale = pow(float(BaseRayCount), float(Cascade));
	float IntervalLength = BaseIntervalPixels * Scale;
	float IntervalStart = BaseIntervalPixels * (Scale - 1.0) / (float(BaseRayCount) - 1.0);
	float IntervalEnd = IntervalStart + IntervalLength;

	float4 Radiance = float4(0.0, 0.0, 0.0, 0.0);

	float2 ProbeBufferUV = (ProbeCenter - SceneColorViewport_ViewportMin + View.ViewRectMin.xy) * View.BufferSizeAndInvSize.zw;
	float ProbeDeviceZ = SceneDepth.SampleLevel(GlobalPointClampedSampler, ProbeBufferUV, 0).r;
	float ProbeDepth = ConvertFromDeviceZ(ProbeDeviceZ);

	float2 ProbeUV = (ProbeCenter - SceneColorViewport_ViewportMin) * SceneColorViewport_ViewportSizeInverse;
	float2 ProbeNDC = ViewportUVToScreenPos(ProbeUV);
	float3 ProbeViewPos = float3(ProbeNDC * ProbeDepth / float2(View.ViewToClip[0][0], View.ViewToClip[1][1]), ProbeDepth);

	FGBufferData GBuffer = GetGBufferData(ProbeBufferUV);
	float3 ProbeNormalWS = GBuffer.WorldNormal;
	float3 ProbeNormal = mul(ProbeNormalWS, (float3x3)View.TranslatedWorldToView);

	float3 ViewDir = normalize(-ProbeViewPos);

	if (ProbeDeviceZ <= 0.0)
	{
		ProbeCascade[PixelId] = float4(0, 0, 0, 1);
		return;
	}

	// March SceneColor
	for (int i = 0; i < BaseRayCount; i++)
	{
		float Index = BaseIndex + float(i);
		// Add 0.5 radians to avoid vertical angles
		float AngleStep = Index + 0.5;
		float Angle = ((2 * PI) / RayCount) * AngleStep;
		float2 RayDirection = float2(cos(Angle), -sin(Angle));

		// Project the pixel so we have a depth direction instead of just 2d
		float2 DirPixel = ProbeCenter + RayDirection;
		float2 DirUV = (DirPixel - SceneColorViewport_ViewportMin) * SceneColorViewport_ViewportSizeInverse;
		float2 DirNDC = ViewportUVToScreenPos(DirUV);
		float3 DirViewPos = float3(DirNDC * ProbeDepth / float2(View.ViewToClip[0][0], View.ViewToClip[1][1]), ProbeDepth);
		float3 SliceRaw = DirViewPos - ProbeViewPos;
		float3 T = SliceRaw - ViewDir * dot(SliceRaw, ViewDir);
		float TLen = length(T);
		if (TLen < 1e-6)
			continue;  // fully tangental to camera
		T /= TLen;

		float NTheta = SliceAngle(ProbeNormal, T, ViewDir);
		uint NormalMask = BitsForSpan(NTheta - PI * 0.5, NTheta + PI * 0.5);
		float NormalSectorCount = max(1.0, (float)countbits(NormalMask));
		float4 RadDelta = float4(0.0, 0.0, 0.0, 1.0);

		uint OcclusionBits = 0;
		float3 SliceRadiance = 0;

		// Thickness of geometry, since we only have the surface depth.
		const float ThicknessWorld = 20.0;

		const int MaxSteps = 32;
		float T0 = max(IntervalStart, 1.0);
		float Span = IntervalEnd - T0;
		if (Span <= 0.0)
		{
			Radiance += RadDelta;
			continue;
		}

		int NumSteps = (int)clamp(ceil(Span), 1.0, (float)MaxSteps);
		float StepPixels = Span / (float)NumSteps;

		for (int Step = 0; Step < NumSteps; Step++)
		{
			float t = T0 + (float(Step) + 0.5) * StepPixels;

			float2 SamplePixel = ProbeCenter + RayDirection * t;
			if (any(SamplePixel < SceneColorViewport_ViewportMin) || any(SamplePixel >= SceneColorViewport_ViewportMax))
			{
				break;	// miss
			}

			float SampleDeviceZ = SceneDepth.Load(int3(int2(SamplePixel + View.ViewRectMin.xy), 0)).r;
			if (SampleDeviceZ <= 0.0)
				continue;  // Sky

			float SampleDepth = ConvertFromDeviceZ(SampleDeviceZ);
			float3 SampleViewPos = UnprojectPixel(SamplePixel, SampleDepth);

			float3 DirFromView = normalize(SampleViewPos);
			float3 DeltaFront = SampleViewPos - ProbeViewPos;
			float3 DeltaBack = DeltaFront + DirFromView * ThicknessWorld;

			uint SectorMask = BitsForSpan(SliceAngle(DeltaFront, T, ViewDir), SliceAngle(DeltaBack, T, ViewDir));
			SectorMask &= NormalMask;

			uint NewBits = SectorMask & ~OcclusionBits;
			if (NewBits != 0)
			{
				float2 SampleUV = (SamplePixel + View.ViewRectMin.xy) * View.BufferSizeAndInvSize.zw;

				float3 Color = OriginalSceneColor.SampleLevel(GlobalBilinearClampedSampler, SampleUV, 0).rgb;
				// Only apply from non occluded direction slices
				SliceRadiance += Color * ((float)countbits(NewBits) / NormalSectorCount);
			}
			OcclusionBits |= SectorMask;
			if ((OcclusionBits & NormalMask) == NormalMask)
				break;
		}

		RadDelta.rgb = SliceRadiance;
		RadDelta.a = 1.0 - (float)countbits(OcclusionBits) / NormalSectorCount;

		if (Cascade < CascadeCount - 1 && RadDelta.a != 0.0)
		{
			// Merge upper cascade

			// The spacing between probes
            float UpperSpacing = pow(SqrtBase, Cascade + 1);
            float2 UpperSize = floor(SceneColorViewport_ViewportSize / UpperSpacing);
            int2 TilePos = (int2) (float2(fmod(Index, UpperSpacing),
                                floor(Index / UpperSpacing)) * UpperSize);
			float2 UpperGridPos = (ProbeRelativePosition + 0.5) * (UpperSize / Size) - 0.5;
			int2 MinPos = (int2)floor(UpperGridPos);
			float2 Fract = UpperGridPos - (float2)MinPos;

			int2 MaxClamp = (int2)UpperSize - 1;
			int2 MaxPos[4];
			MaxPos[0] = clamp(MinPos + int2(0, 0), int2(0, 0), MaxClamp);
			MaxPos[1] = clamp(MinPos + int2(1, 0), int2(0, 0), MaxClamp);
			MaxPos[2] = clamp(MinPos + int2(0, 1), int2(0, 0), MaxClamp);
			MaxPos[3] = clamp(MinPos + int2(1, 1), int2(0, 0), MaxClamp);

			float4 Weights = float4((1.0 - Fract.x) * (1.0 - Fract.y), Fract.x * (1.0 - Fract.y), (1.0 - Fract.x) * Fract.y, Fract.x * Fract.y);

			float4 ProbeDepths;
			[unroll] for (int c = 0; c < 4; c++)
			{
				int2 ScreenPixel = (int2)(((float2)MaxPos[c] + 0.5) * UpperSpacing + SceneColorViewport_ViewportMin);
				ProbeDepths[c] = ConvertFromDeviceZ(SceneDepth.Load(int3(ScreenPixel + (int2)View.ViewRectMin.xy, 0)).r);
			}

			float MinDepth = min(min(ProbeDepths.x, ProbeDepths.y), min(ProbeDepths.z, ProbeDepths.w));
			float MaxDepth = max(max(ProbeDepths.x, ProbeDepths.y), max(ProbeDepths.z, ProbeDepths.w));
			float AvgDepth = dot(ProbeDepths, 0.25);

			if ((MaxDepth - MinDepth) / AvgDepth > 0.1)
			{
				Weights *= 1.0 / (abs(ProbeDepths - ProbeDepth) + 0.0001);
			}
			Weights /= dot(Weights, 1.0);

			float4 Upper = 0;
			[unroll] for (int c = 0; c < 4; c++)
			{
				Upper += PreviousProbeCascade.Load(int3(TilePos + MaxPos[c], 0)) * Weights[c];
			}

			RadDelta.rgb += RadDelta.a * Upper.rgb;
			RadDelta.a *= Upper.a;
		}
		// Accumulate total radiance
		Radiance += RadDelta;
	}
	float4 Output = Radiance / float(BaseRayCount);

	ProbeCascade[uint2(PixelId)] = Output;

	// float2 StartDepthUV = (ProbeCenter - SceneColorViewport_ViewportMin + View.ViewRectMin.xy)
	//                 * View.BufferSizeAndInvSize.zw;
	// float Depth = SceneDepth.SampleLevel(GlobalBilinearClampedSampler, StartDepthUV, 0);
	// ProbeCascades[uint3(PixelId, Cascade)] = float4(float3(Depth, Depth, Depth), 1.0);

	// float2 HitBufferUV = ProbeCenter * SceneColorViewport_ViewportSizeInverse
	//                + SceneColorViewport_UVViewportMin;
	// float4 ColorSample = OriginalSceneColor.SampleLevel(GlobalBilinearClampedSampler, float2(HitBufferUV.xy), 0.0);
	// ProbeCascade[PixelId] = float4(ProbeNormalWS, 1.0);

	// ProbeCascades[uint3(PixelId, Cascade)] = float4(ProbeCenter * SceneColorViewport_ViewportSizeInverse,0.0,1.0);
}